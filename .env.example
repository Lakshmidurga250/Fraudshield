# FraudShield Configuration Example
FLASK_ENV=development
SECRET_KEY=replace-with-a-cryptographically-secure-random-key-in-production
DATABASE_URL=sqlite:///fraudshield.db
DEFAULT_DECISION_THRESHOLD=0.5
MODEL_STORAGE_DIR=models/artifacts
DATASET_STORAGE_DIR=datasets
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
MAX_CONTENT_LENGTH=16777216
